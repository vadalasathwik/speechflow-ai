APP_NAME=SpeechFlow AI API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api
ALLOWED_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://speechflow:speechflow@localhost:5432/speechflow
# A Faster-Whisper repository name (for example, small) or an absolute local model directory.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto
WHISPER_VAD_FILTER=true
WHISPER_BEAM_SIZE=5
WHISPER_TEMPERATURE=0.0
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_ENABLE_SCRIPT_RETRY=true
MAX_AUDIO_SIZE_MB=10
MAX_AUDIO_DURATION_SECONDS=120
MAX_REALTIME_SESSION_SECONDS=300
MAX_REALTIME_AUDIO_BYTES=20971520
REALTIME_WINDOW_SECONDS=8
REALTIME_OVERLAP_SECONDS=1
